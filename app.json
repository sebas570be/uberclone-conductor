{
  "expo": {
    "name": "UberClone Conductor",
    "slug": "uberclone-conductor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sebas570be.uberclone.conductor",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "UberClone Conductor necesita acceder a tus fotos para que subas tu foto de perfil, la del vehículo y las de tus documentos.",
          "cameraPermission": "UberClone Conductor necesita la cámara para tomar tu foto de perfil, la del vehículo y las de tus documentos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UberClone Conductor usa tu ubicación para mostrarte en el mapa y compartirla mientras estás Disponible para recibir solicitudes."
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#111827",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7204cdb9-80f6-41d4-b99b-6419257cef8b"
      }
    },
    "owner": "fraybenitezs-team"
  }
}

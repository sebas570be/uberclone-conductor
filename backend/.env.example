# Copia este archivo como backend/.env (el .env NO se sube a Git).
# Ruta, relativa a la carpeta backend, del archivo de la cuenta de servicio de
# Firebase (Configuración del proyecto → Cuentas de servicio → Generar nueva
# clave privada). El archivo de la llave tampoco se sube a Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Puerto del servidor de pagos (npm start).
PORT=3000

# Access Token de Mercado Pago de la cuenta VENDEDOR DE PRUEBA: entrar con esa
# cuenta → Tus integraciones → tu aplicación → Credenciales de producción.
# Empieza por APP_USR-. SECRETO: nunca en Git ni en la app.
MP_ACCESS_TOKEN=

# local env files
.env
.env*.local

# Credencial de administrador de Firebase (cuenta de servicio): SECRETA.
# Da acceso total al proyecto; solo vive en el PC, nunca en Git.
backend/serviceAccountKey.json
*-firebase-adminsdk-*.json

# Configuración de Firebase para Android (notificaciones push). EAS la toma de
# una variable de tipo archivo (GOOGLE_SERVICES_JSON), así que no hace falta en Git.
google-services.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Copia este archivo como .env y completa los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → app web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary (fotos del registro). Consola de Cloudinary: el Cloud name y el
# nombre del upload preset SIN FIRMA (Unsigned). El API Secret NUNCA va aqui.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
